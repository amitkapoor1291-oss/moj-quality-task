{
  "name": "moj-quality-engineering-task",
  "version": "1.0.0",
  "private": true,
  "description": "API (Swagger Petstore) and UI (OrangeHRM) test automation framework using Playwright Test",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
